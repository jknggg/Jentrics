{
  "name": "jentrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Windows tray utility for coding agent readiness",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/jknggg/Jentrics.git"},
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm test",
    "test": "node --test tests/*.test.ts",
    "desktop:dev": "tauri dev --features desktop",
    "desktop:build": "tauri build --features desktop --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "linkedom": "0.18.13",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
