{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard",
  "description": "Fixed local dashboard commands for sanitized observations, reviewed application configuration, display preferences, data-source/diagnostic status and monitoring controls. No generic filesystem, SQL, shell or network permission.",
  "windows": [
    "dashboard"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-is-maximized",
    "core:window:allow-unmaximize",
    "core:window:allow-maximize",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-min-size",
    "core:window:allow-set-decorations",
    "core:window:allow-set-shadow",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color",
    "core:window:allow-set-effects",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-get-dashboard-state",
    "allow-export-configuration",
    "allow-import-configuration",
    "allow-get-display-settings",
    "allow-set-display-settings",
    "allow-get-storage-maintenance",
    "allow-get-adapter-catalog",
    "allow-get-diagnostics-status",
    "allow-take-settings-request",
    "allow-refresh-agents-command",
    "allow-prepare-wake",
    "allow-confirm-wake",
    "allow-get-history",
    "allow-get-history-settings",
    "allow-set-history-retention",
    "allow-clear-history",
    "allow-get-claude-bridge-status",
    "allow-prepare-claude-bridge",
    "allow-apply-claude-bridge",
    "allow-restore-claude-bridge",
    "allow-get-alert-settings",
    "allow-set-alert-settings",
    "allow-request-alert-permission",
    "allow-get-metrics",
    "allow-set-metric-settings",
    "allow-clear-metric-history",
    "allow-get-pricing",
    "allow-set-price-override",
    "allow-remove-price-override",
    "allow-estimate-cost",
    "allow-get-monitor-settings",
    "allow-set-monitor-settings",
    "allow-send-test-notification"
  ]
}
