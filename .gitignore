# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Frontend dependencies and generated bundles
node_modules/
dist/
.vite/
coverage/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.local

# Runtime history and diagnostics; use sanitized JSON fixtures for tests
*.sqlite
*.sqlite3
*.db
*-wal
*-shm
*.log

# Local implementation ledger and verification artifacts
.superpowers/
src-tauri/gen/
src-tauri/permissions/autogenerated/

# Local engineering records; publish only README-linked documentation/assets
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/dashboard-preview.jpg
AGENTS.md
CONTINUITY.md


# Private engineering and measurement tools
CONTRIBUTING.md
/tools/benchmark*
/tools/metrics-burst.ps1
/tools/tests/
/src-tauri/src/bin/webview_baseline.rs
/src-tauri/src/process/job_accounting_tests.rs
/src-tauri/src/process/job_debug_tests.rs
/src-tauri/tests/native_metadata_trace.rs
/src-tauri/tests/resource_projection_contract.rs
/src-tauri/tests/support/allocation_meter.rs
/src-tauri/src/**/README.md
/tools/check-quit.ps1
